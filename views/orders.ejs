<!DOCTYPE html>
<html>
<head>
    <title>My Orders</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <script>
        setTimeout(function(){
           location.reload();
        }, 5000); // Refreshes page every 5 seconds to check status
    </script>
</head>
<body class="container mt-5">
    <nav class="d-flex justify-content-between mb-4">
        <h2>📦 My Order History</h2>
        <a href="/" class="btn btn-outline-secondary">Back to Shop</a>
    </nav>
    
    <% if (orders.length === 0) { %>
        <div class="alert alert-info">You haven't placed any orders yet.</div>
    <% } %>

    <% orders.forEach(order => { %>
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <span>
                    <strong>Order Date:</strong> <%= order.orderDate.toDateString() %>
                </span>
                
                <% let badgeClass = 'bg-warning text-dark'; %>
                <% if(order.status.includes('Shipped')) badgeClass = 'bg-info text-white'; %>
                <% if(order.status.includes('Delivered')) badgeClass = 'bg-success text-white'; %>
                
                <span class="badge <%= badgeClass %> fs-6">
                    <%= order.status %>
                </span>
            </div>
            <div class="card-body">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Qty</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% order.items.forEach(item => { %>
                        <tr>
                            <td>
                                <% if(item.product) { %>
                                    <%= item.product.name %>
                                <% } else { %>
                                    <span class="text-muted">Item Discontinued</span>
                                <% } %>
                            </td>
                            <td><%= item.quantity %></td>
                            <td>$<%= item.price %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <hr>
                <h4 class="text-end text-success">Total Paid: $<%= order.totalAmount.toFixed(2) %></h4>
            </div>
        </div>
    <% }) %>
</body>
</html>