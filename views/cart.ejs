<!DOCTYPE html>
<html>
<head>
    <title>Shopping Cart</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-5">
    
    <nav class="d-flex justify-content-between mb-4">
        <h2>🛒 Your Shopping Cart</h2>
        <a href="/" class="btn btn-outline-secondary">Back to Shop</a>
    </nav>

    <div class="table-responsive mt-4">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                <% let total = 0; %>
                <% let hasItems = false; %>
                
                <% cart.forEach(item => { %>
                    <% if (item.productId) { %>
                        <% hasItems = true; %>
                        <tr>
                            <td><%= item.productId.name %></td>
                            <td><%= item.quantity %></td>
                            <td>$<%= item.productId.price %></td>
                            <td>$<%= (item.productId.price * item.quantity).toFixed(2) %></td>
                        </tr>
                        <% total += item.productId.price * item.quantity; %>
                    <% } %>
                <% }) %>
                
                <% if (!hasItems) { %>
                    <tr><td colspan="4" class="text-center p-4">Your cart is empty. <a href="/">Go shopping!</a></td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <% if (total > 0) { %>
    <div class="d-flex justify-content-end align-items-center mt-3 p-3 bg-light rounded shadow-sm">
        <h3 class="me-4 mb-0">Total: $<%= total.toFixed(2) %></h3>
        
        <form action="/checkout" method="POST">
            <button type="submit" class="btn btn-warning btn-lg fw-bold">
                Place Order & Checkout 💳
            </button>
        </form>
        
    </div>
    <% } %>

</body>
</html>