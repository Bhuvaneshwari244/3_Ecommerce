<!DOCTYPE html>
<html>
<head>
    <title>Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
    <nav class="navbar navbar-light bg-light mb-4 px-3">
        <a class="navbar-brand" href="/">CodeAlpha Store</a>
        <div class="ms-auto">
            <% if (user) { %>
                <a href="/cart" class="btn btn-primary">Cart</a>
                <a href="/add-product" class="btn btn-secondary">Add Item</a>
                <a href="/logout" class="btn btn-danger">Logout</a>
            <% } else { %>
                <a href="/login" class="btn btn-outline-primary">Login</a>
                <a href="/register" class="btn btn-primary">Register</a>
            <% } %>
        </div>
    </nav>
    <div class="row">
        <% products.forEach(product => { %>
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <% if(product.image) { %>
                <img src="<%= product.image %>" class="card-img-top" style="height:200px; object-fit:cover;">
                <% } %>
                <div class="card-body">
                    <h5><%= product.name %></h5>
                    <p class="text-success">$<%= product.price %></p>
                    <a href="/product/<%= product._id %>" class="btn btn-sm btn-info">View</a>
                    <form action="/add-to-cart/<%= product._id %>" method="POST" class="d-inline">
                        <button class="btn btn-sm btn-success">Add</button>
                    </form>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</body>
</html>